# Copy these into Railway → your service → Variables. Only OPENAI_API_KEY is required for voice.

OPENAI_API_KEY=sk-...

# Optional: require a code before the app spends OpenAI credits (visitors are asked once; it's remembered).
# ACCESS_CODE=pick-something

# Optional: per-visitor limit on OpenAI-backed requests (default 30 per minute).
# RATE_LIMIT_PER_MIN=30

# Optional model overrides (defaults shown).
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TEXT_MODEL=gpt-5.4-nano
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# OPENAI_TTS_INSTRUCTIONS=Speak like a calm, friendly poker coach. Clear and unhurried.

# Optional: OPENAI_ORG_ID, OPENAI_PROJECT_ID, OPENAI_BASE_URL, OPENAI_TIMEOUT_MS=30000, MAX_AUDIO_MB=15
