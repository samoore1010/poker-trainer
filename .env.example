# Copy these into Railway → your service → Variables.
# OPENAI_API_KEY turns on voice (transcription, text-to-speech) and the coach agent.
# ANTHROPIC_API_KEY (optional) runs the coach agent on Claude instead.

OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Coach agent. AGENT_PROVIDER=openai|anthropic; unset = Claude when ANTHROPIC_API_KEY is set, else OpenAI.
# AGENT_PROVIDER=
# OPENAI_AGENT_MODEL=gpt-6-astra
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_AGENT_REASONING=low     (OpenAI reasoning models: none | low | medium | high, or off)
# AGENT_EFFORT=low               (Claude: low | medium | high | xhigh | max; higher = slower, more thorough)
# AGENT_MAX_ROUNDS=4             (model calls per request; a setup normally takes 2)
# AGENT_TIMEOUT_MS=90000

# Optional: require a code before the app spends OpenAI credits (visitors are asked once; it's remembered).
# ACCESS_CODE=pick-something

# Optional: per-visitor limit on OpenAI-backed requests (default 30 per minute).
# RATE_LIMIT_PER_MIN=30

# Optional model overrides (defaults shown).
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TEXT_MODEL=gpt-5.4-nano
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# OPENAI_TTS_INSTRUCTIONS=Speak like a calm, friendly poker coach. Clear and unhurried.

# Optional: OPENAI_ORG_ID, OPENAI_PROJECT_ID, OPENAI_BASE_URL, OPENAI_TIMEOUT_MS=30000, MAX_AUDIO_MB=15

# Camera card reading (the phone asks a vision model when the table changes). Uses Claude when ANTHROPIC_API_KEY is
# set, otherwise OpenAI. VISION_MODEL picks the Claude model; claude-sonnet-5-5 or claude-opus-5-5 read more carefully
# but cost more per check.
# VISION_PROVIDER=anthropic
# VISION_MODEL=claude-haiku-5-5
# OPENAI_VISION_MODEL=
# Sync table (reads every seat's name, stack, the dealer and the betting when you press it): a more careful model.
# VISION_SYNC_MODEL=claude-sonnet-5-5
# OPENAI_VISION_SYNC_MODEL=
